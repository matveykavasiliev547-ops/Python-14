FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Копируем и ставим зависимости (если они есть)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем весь твой код (run.py, gui.py, game.py)
COPY . .

# Запускаем твою главную точку входа!
CMD ["python", "run.py"]